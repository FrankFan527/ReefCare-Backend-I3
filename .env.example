# ReefCare MY - Environment Variable Example
# Copy this file to .env and replace placeholder values with real secrets.

# AI / Smart Report
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
SMART_REPORT_TIMEOUT_SECONDS=20
SMART_REPORT_RATE_LIMIT_REQUESTS=10
SMART_REPORT_RATE_LIMIT_WINDOW_SECONDS=60

# Application
APP_NAME=ReefCare MY
APP_ENV=development
API_V1_PREFIX=/api/v1

# Authentication
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+psycopg://username:password@host/database?sslmode=require

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://reefcare-frontend.vercel.app,https://reef-care-my-frontend-iteration2.vercel.app

# Login Rate Limit
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Evidence Storage
EVIDENCE_STORAGE_DIR=./private_evidence

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_STORAGE_BUCKET=reefcare-evidence

# Epic 9 Reef-Aware Dive Planning

PLANNING_FORECAST_ENABLED=true
PLANNING_FORECAST_HORIZON_DAYS=7
PLANNING_FORECAST_TIMEOUT_SECONDS=10
PLANNING_TIMEZONE=Asia/Kuala_Lumpur

OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# Draft deterministic assessment rule.
PLANNING_RULE_VERSION=i3-draft-1

PLANNING_WAVE_MORE_FAVOURABLE_MAX_M=0.8
PLANNING_WAVE_LESS_FAVOURABLE_ABOVE_M=1.5

PLANNING_WIND_MORE_FAVOURABLE_MAX_KMH=12
PLANNING_WIND_LESS_FAVOURABLE_ABOVE_KMH=20

# US5.9 requires no AI API key. Change the version when tuning rules.
RELATED_INCIDENT_RULE_VERSION=rid-v2-image
RELATED_INCIDENT_WINDOW_DAYS=7
RELATED_INCIDENT_POOL_LIMIT=200
RELATED_INCIDENT_RESULT_LIMIT=20
RELATED_INCIDENT_TIMEOUT_SECONDS=30
RELATED_INCIDENT_NEARBY_METRES=500
RELATED_INCIDENT_DEPTH_TOLERANCE_METRES=5
RELATED_INCIDENT_DESCRIPTION_THRESHOLD=0.35
RELATED_INCIDENT_MIN_SCORE=0.55
RELATED_INCIDENT_MEDIUM_SCORE=0.70
RELATED_INCIDENT_HIGH_SCORE=0.85
RELATED_INCIDENT_IMAGES_ENABLED=true
RELATED_INCIDENT_IMAGE_MODEL_PATH=models/resnet18-avgpool512.onnx
RELATED_INCIDENT_IMAGE_THRESHOLD=0.80
RELATED_INCIDENT_IMAGE_TOP_K=10
RELATED_INCIDENT_IMAGES_PER_REPORT=8
RELATED_INCIDENT_IMAGE_TIMEOUT_SECONDS=12
RELATED_INCIDENT_IMAGE_MAX_PIXELS=20000000